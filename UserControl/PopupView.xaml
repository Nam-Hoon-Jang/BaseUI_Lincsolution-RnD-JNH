<UserControl x:Class="BaseUI.PopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BaseUI"
             mc:Ignorable="d" 
             Width="380" Height="300" x:Name="PopupViewWindow">
    <Grid Width="{Binding ElementName=PopupViewWindow, Path=ActualWidth}" Height="{Binding ElementName=PopupViewWindow, Path=ActualHeight}">
        <Grid.RowDefinitions>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource StBorderPopup}" CornerRadius="10 10 0 0" BorderThickness="1"
                Tag="{Binding PopupType, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PopupTypeToAlarmConverter}}"/>
        <Border Grid.Row="1" Background="{DynamicResource BrushMainBackground}" CornerRadius="0 0 10 10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Image Grid.Row="1" Style="{StaticResource StImgPopup}" 
                       Tag="{Binding PopupType, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PopupTypeToAlarmConverter}}"/>
                <TextBlock x:Name="TitleMessage" Grid.Row="3" Style="{StaticResource  StTextBlockSubView_Content_Big}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="5" Style="{StaticResource  StTextBlockSubViewTitle}" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding PopupContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnLeft" 
                            Grid.Column="1" Width="100" Style="{StaticResource StPopupButton}"
                            Tag="{Binding PopupType, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PopupTypeToBtnStateConverter}}"
                            Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding CmdParBtnLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button x:Name="BtnRight" 
                            Grid.Column="3" Width="100" Style="{StaticResource StPopupButton}"
                            Tag="{StaticResource Button.Idle}"
                            Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding CmdParBtnRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button x:Name="BtnSingle" 
                            Grid.Column="1" Grid.ColumnSpan="3" Width="200" Style="{StaticResource StPopupButton}"
                            HorizontalAlignment="Center"
                            Tag="{Binding PopupType, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PopupTypeToBtnStateConverter}}"
                            Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding CmdParBtnLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
