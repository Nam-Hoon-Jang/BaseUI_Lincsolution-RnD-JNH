<UserControl x:Class="BaseUI.AlarmListPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BaseUI"
             mc:Ignorable="d" 
             Width="380" Height="350" x:Name="AlarmListPopupViewWindow">
    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="2"
            CornerRadius="10" Background="{DynamicResource BrushMainBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource StNormalButton_NoIcon_NoBorder}" 
                        Content="{DynamicResource AlarmListPopup_Clear}" FontSize="12"
                        Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding CmdParAlarmAllClear, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Border Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0 0 0 1"/>
            </Grid>
            <ListView x:Name="ContentList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                      ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      ItemContainerStyle="{StaticResource StAlarmListViewItem}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      VirtualizingPanel.IsVirtualizing="False"
                      VirtualizingPanel.VirtualizationMode="Standard">
                <ListView.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource StListViewScrollBar}">
                        <Setter Property="Height" Value="200"/>
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Btn_Click" Width="360" Height="60"
                                Style="{StaticResource StAlarmListViewButton}">
                            <Grid Width="360" Height="60">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="5"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="1" Grid.Row="1" Style="{StaticResource StLabelAlarmStatus}"
                                       Tag="{Binding AlarmType}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left"
                                           Style="{StaticResource StTextBlockSubView_Content}" FontSize="12"
                                           Text="{Binding Message}"/>
                                <TextBlock Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Style="{StaticResource StTextBlockSubView_Content}" FontSize="12"
                                           TextWrapping="WrapWithOverflow" TextAlignment="Left"
                                           Text="{Binding CreatedAt}"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
