<UserControl x:Class="BaseUI.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BaseUI"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:TestDashboardViewModel, IsDesignTimeCreatable=True}"
             Width="1640" Height="980" MaxWidth="1832" MinWidth="1640"
             x:Name="DashboardViewWindow">
    <Grid Width="{Binding ElementName=DashboardViewWindow, Path=ActualWidth}" Height="{Binding ElementName=DashboardViewWindow, Path=ActualHeight}" 
      Background="{DynamicResource BrushMainBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="176"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Column="0" Grid.Row="0">
            <TextBlock Style="{StaticResource StTextBlockSubTitle}" Text="{DynamicResource MainMenu_Dashboard}"/>
            <Border BorderThickness="0 0 1 0" BorderBrush="{DynamicResource BrushBorder}"/>
        </Grid>
        <Grid Grid.Column="1" Grid.Row="0">
            
        </Grid>
        <Grid Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource BrushUnPressedBackground}">
            <Grid Margin="16" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="635" x:Name="ColumnLeft"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="589" x:Name="ColumnMiddle"/>
                    <ColumnDefinition Width="16" x:Name="ResizableColumn"/>
                    <ColumnDefinition Width="352" x:Name="ColumnRight"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Background="{DynamicResource BrushMainBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource StTextBlockSubViewTitle}" Text="{DynamicResource DashboardTitle_BuildFile}"/>
                </Grid>
                <Grid Grid.Column="2" Background="{DynamicResource BrushMainBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource StTextBlockSubViewTitle}" Text="{DynamicResource DashboardTitle_BuildProcess}"/>
                    <TextBlock Grid.Column="1" Grid.Row="4" Style="{StaticResource StTextBlockSubView_SubTitle}" Text="{DynamicResource DashboardTSubitle_BuildProgress}"/>
                    <Grid Grid.Column="1" Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Ellipse Grid.Column="0" Panel.ZIndex="0" Stroke="{DynamicResource BrushIdleTextBoxTagForeground}" StrokeThickness="25"
                                     Width="200" Height="200"
                                     local:EllipseProgressBar.Value="100"/>
                            <Ellipse Grid.Column="0" Panel.ZIndex="1" Stroke="{DynamicResource BrushMainThema}" StrokeThickness="25"
                                     Width="200" Height="200"
                                     local:EllipseProgressBar.Value="{Binding BuildProgressBarValue}"/>
                            <TextBlock Grid.Column="0" Panel.ZIndex="1" Style="{StaticResource StTextBlockSubView_Content_Big}" HorizontalAlignment="Center" 
                                       Text="{Binding BuildProgressBarValueText}"/>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="1" Style="{StaticResource StLabelSubTitle}" Tag="{StaticResource GeometryElapsedTime}" Content="{DynamicResource DashboardSubTitle_BuildElapsedTime}"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource StTextBlockSubView_Content_Big}"
                                       Text="{Binding ElapsedTime}" FontSize="24"/>
                            <Label Grid.Row="4" Style="{StaticResource StLabelSubTitle}" Tag="{StaticResource GeometryRemainingTime}" Content="{DynamicResource DashboardSubTitle_BuildRemainTime}"/>
                            <TextBlock Grid.Row="5" Style="{StaticResource StTextBlockSubView_Content_Big}"
                                       Text="{Binding RemainingTime}" FontSize="24"/>
                        </Grid>
                    </Grid>
                    <TextBlock Grid.Column="1" Grid.Row="10" Style="{StaticResource StTextBlockSubViewTitle}" Text="{DynamicResource DashboardTitle_BuildFileList}"/>
                    <local:BuildFileListView x:Name="BuildFileList"
                                             Grid.Column="1" Grid.Row="11" 
                                             ItemsSource="{Binding BuildFileList}"
                                             Command="{Binding Command}"
                                             CmdParBtnPreview="{Binding CmdParBtnPreview}"
                                             CmdParBtnBuildStart="{Binding CmdParBtnBuildStart}"/>
                    <Border Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="3" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0 0 0 1"/>
                    <Border Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0 0 0 1"/>
                </Grid>
                <Grid Grid.Column="4" Background="{DynamicResource BrushMainBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="110"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource StTextBlockSubViewTitle}" Text="{DynamicResource DashboardTitle_BuildOverview}"/>
                    <Grid Grid.Column="1" Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="1" Style="{StaticResource StTextBlockSubView_SubTitle}" Text="{DynamicResource DashboardSubTitle_TotalRunningTime}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource StTextBlockSubView_Content_Big}" HorizontalAlignment="Left" 
                                   Text="{Binding TotalRunningTime}"/>
                    </Grid>
                    <Grid Grid.Column="1" Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StTextBlockSubView_SubTitle}" Grid.Row="1" Text="{DynamicResource DashboardSubTitle_BuildStatus}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_SubTitle}" Grid.Row="2" Text="{DynamicResource DashboardSubTitle_BuildElapsedTime}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_SubTitle}" Grid.Row="3" Text="{DynamicResource DashboardSubTitle_BuildRemainTime}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_SubTitle}" Grid.Row="4" Text="{DynamicResource DashboardSubTitle_BuildStartDate}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_SubTitle}" Grid.Row="5" Text="{DynamicResource DashboardSubTitle_BuildEndDate}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_SubTitle}" Grid.Row="6" Text="{DynamicResource DashboardSubTitle_BuildCurrentHeight}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_SubTitle}" Grid.Row="7" Text="{DynamicResource DashboardSubTitle_BuildLayers}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_SubTitle}" Grid.Row="8" Text="{DynamicResource DashboardSubTitle_BuildCurrentProcess}"/>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <Label Style="{StaticResource StLabelOverviewStatus}" Grid.Row="1" Tag="{Binding TagStatus}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_Content}" Grid.Row="2" Text="{Binding ElapsedTime}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_Content}" Grid.Row="3" Text="{Binding RemainingTime}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_Content}" Grid.Row="4" Text="{Binding StartDate}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_Content}" Grid.Row="5" Text="{Binding EndDate}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_Content}" Grid.Row="6" Text="{Binding CurrentHeight}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_Content}" Grid.Row="7" Text="{Binding Layers}"/>
                            <TextBlock Style="{StaticResource StTextBlockSubView_Content}" Grid.Row="8" Text="{Binding CurrentBuildProcess}"/>
                        </Grid>
                    </Grid>
                    <Border Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0 0 0 1"/>
                    <Border Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0 0 0 1"/>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0 0 0 1"/>
    </Grid>
</UserControl>
