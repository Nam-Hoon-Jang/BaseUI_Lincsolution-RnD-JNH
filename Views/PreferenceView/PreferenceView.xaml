<UserControl x:Class="BaseUI.PreferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BaseUI"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:TestPreferenceViewModel, IsDesignTimeCreatable=True}"
             Width="1640" Height="980" MaxWidth="1832"
             x:Name="PreferenceViewWindow">
    <Grid Width="{Binding ElementName=PreferenceViewWindow, Path=ActualWidth}" Height="{Binding ElementName=PreferenceViewWindow, Path=ActualHeight}" 
          Background="{DynamicResource BrushMainBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="176"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Column="0" Grid.Row="0">
            <TextBlock Style="{StaticResource StTextBlockSubTitle}" Text="{DynamicResource MainMenu_Preferences}"/>
            <Border BorderThickness="0 0 1 0" BorderBrush="{DynamicResource BrushBorder}"/>
        </Grid>
        <Grid Grid.Column="1" Grid.Row="0">
            
        </Grid>
        <Grid Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource BrushUnPressedBackground}">
            <Grid Margin="16" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Background="{DynamicResource BrushMainBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource StTextBlockSubViewTitle}" Text="{DynamicResource MainMenu_Preferences}"/>
                    <Grid Grid.Column="1" Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="1" Style="{StaticResource StTextBlockSubView_SubTitle}" Text="{DynamicResource PreferenceSubTitle_ModelName}"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource StTextBlockSubView_SubTitle}" Text="{DynamicResource PreferenceSubTitle_DateTime}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource StTextBlockSubView_SubTitle}" Text="{DynamicResource PreferenceSubTitle_Language}"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource StTextBlockSubView_SubTitle}" Text="{DynamicResource PreferenceSubTitle_SoftwareVersion}"/>
                        <TextBlock Grid.Row="5" Style="{StaticResource StTextBlockSubView_SubTitle}" Text="{DynamicResource PreferenceSubTitle_BuildFileFolderPath}"/>
                        <TextBlock Grid.Row="6" Style="{StaticResource StTextBlockSubView_SubTitle}" Text="{DynamicResource PreferenceSubTitle_LogFileStoragePeriod}"/>
                        <Border Grid.Row="0" Grid.RowSpan="9" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0 0 1 0"/>
                    </Grid>
                    <Grid Grid.Column="2" Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource StTextBlockSubView_Content}" Text="Lincsolution MBJ v3"/>
                        <TextBlock Grid.Column="1" Grid.Row="2" Style="{StaticResource StTextBlockSubView_Content}" Text="{Binding SystemDateTime, Converter={StaticResource DateTimeConverter}}"/>
                        <StackPanel Grid.Column="1" Grid.Row="3" Style="{StaticResource StStackPanel_Preference}">
                            <ComboBox Style="{StaticResource StCombboBoxPreference}" 
                                      ItemsSource="{Binding LanguageListSource}" 
                                      SelectedItem="{Binding SelectedLanguage}" Margin="0 0 10 0"/>
                            <Button Style="{StaticResource StNormalButton_NoIcon}" Content="{DynamicResource PreferenceBtnContentSet}" 
                                    Command="{Binding Command}"
                                    CommandParameter="{Binding CmdParBtnLangSet}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Grid.Row="4" Style="{StaticResource StTextBlockSubView_Content}" Text="{Binding SoftwareVersion}"/>
                        <StackPanel Grid.Column="1" Grid.Row="5" Style="{StaticResource StStackPanel_Preference}">
                            <TextBlock Style="{StaticResource StTextBlockSubView_Content}" Width="245" 
                                       Text="{Binding BuildFileDir}"/>
                            <Button Style="{StaticResource StNormalButton_NoIcon}" Content="{DynamicResource PreferenceBtnContentSet}" Margin="10 0 0 0"
                                    Command="{Binding Command}"
                                    CommandParameter="{Binding CmdParBtnBuildFileDirSet}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="6" Style="{StaticResource StStackPanel_Preference}">
                            <TextBlock Style="{StaticResource StTextBlockSubView_Content}" Width="135"
                                       Text="{DynamicResource PreferenceContent_BuildLog}"/>
                            <TextBox Style="{StaticResource StTextBoxPreference}" Margin="10 0 0 0"
                                     PreviewTextInput="TextBoxValidationNumOnly"
                                     Tag="{DynamicResource PreferenceTag_Day}"
                                     Text="{Binding BuildLogStoragePeriod}"/>
                            <Button Style="{StaticResource StNormalButton_NoIcon}" Content="{DynamicResource PreferenceBtnContentSet}" Margin="10 0 0 0"
                                    Command="{Binding Command}"
                                    CommandParameter="{Binding CmdParBtnBuildLogPeriodSet}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="7" Style="{StaticResource StStackPanel_Preference}">
                            <TextBlock Style="{StaticResource StTextBlockSubView_Content}" Width="135"
                                       Text="{DynamicResource PreferenceContent_SystemLog}"/>
                            <TextBox Style="{StaticResource StTextBoxPreference}" Margin="10 0 0 0"
                                     PreviewTextInput="TextBoxValidationNumOnly"
                                     Tag="{DynamicResource PreferenceTag_Day}"
                                     Text="{Binding SystemLogStoragePeriod}"/>
                            <Button Style="{StaticResource StNormalButton_NoIcon}" Content="{DynamicResource PreferenceBtnContentSet}" Margin="10 0 0 0"
                                    Command="{Binding Command}"
                                    CommandParameter="{Binding CmdParBtnSystemLogPeriodSet}"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="5" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/>
                    <Border Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0 0 0 1"/>
                </Grid>
                <Grid Grid.Column="2" Background="{DynamicResource BrushMainBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource StTextBlockSubViewTitle}" Text="{DynamicResource SettingsTitle}"/>
                    <Grid Grid.Column="1" Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.RowSpan="9" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0 0 1 0"/>
                    </Grid>
                    <Grid Grid.Column="2" Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    </Grid>
                    <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="5" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/>
                    <Border Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0 0 0 1"/>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0 0 0 1"/>
    </Grid>
</UserControl>
