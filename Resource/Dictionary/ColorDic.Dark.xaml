<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="BrushWhite" Color="{DynamicResource ColorWhite}"/>
    <SolidColorBrush x:Key="BrushBlack" Color="{DynamicResource ColorBlack}"/>
    <SolidColorBrush x:Key="BrushMainBackground" Color="{DynamicResource ColorMainBackground}"/>
    <SolidColorBrush x:Key="BrushMainThema" Color="{DynamicResource ColorMainThema}"/>
    <SolidColorBrush x:Key="BrushMainThemaLowOpacity" Color="{DynamicResource ColorMainThema}" Opacity="0.2"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{DynamicResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushForegroundNormal" Color="{DynamicResource ColorWhite}"/>
    <SolidColorBrush x:Key="BrushForegroundNormalReverse" Color="{DynamicResource ColorBlack}"/>
    <SolidColorBrush x:Key="BrushSelectedBackground" Color="{DynamicResource ColorSelectedBackground}" Opacity="0.2"/>
    <SolidColorBrush x:Key="BrushSelectedBackgroundHighOpacity" Color="{DynamicResource ColorSelectedBackground}" Opacity="0.7"/>
    <SolidColorBrush x:Key="BrushSelectedForeground" Color="{DynamicResource ColorSelectedBackground}"/>
    <SolidColorBrush x:Key="BrushUnPressedBackground" Color="{DynamicResource ColorUnPressedBackground}"/>
    <SolidColorBrush x:Key="BrushUnPressedForeground" Color="{DynamicResource ColorUnPressedForeground}"/>
    <SolidColorBrush x:Key="BrushPressedBackground" Color="{DynamicResource ColorPressedBackground}"/>
    <SolidColorBrush x:Key="BrushIdleBackground" Color="{DynamicResource ColorIdleBackground}"/>
    <SolidColorBrush x:Key="BrushIdleForeground" Color="{DynamicResource ColorIdleForeground}"/>
    <SolidColorBrush x:Key="BrushIdleTextBoxBackground" Color="{DynamicResource ColorIdleTextBoxBackground}"/>
    <SolidColorBrush x:Key="BrushIdleTextBoxTagForeground" Color="{DynamicResource ColorIdleTextBoxForeground}" Opacity="0.5"/>
    <SolidColorBrush x:Key="BrushWarning" Color="{DynamicResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushWarningLowOpacity" Color="{DynamicResource ColorWarning}" Opacity="0.2"/>
    <SolidColorBrush x:Key="BrushError" Color="{DynamicResource ColorError}"/>
    <SolidColorBrush x:Key="BrushErrorLowOpacity" Color="{DynamicResource ColorError}" Opacity="0.2"/>
    <SolidColorBrush x:Key="BrushErrorPressed" Color="{DynamicResource ColorErrorPressed}"/>
    <SolidColorBrush x:Key="BrushErrorPressedLowOpacity" Color="{DynamicResource ColorErrorPressed}" Opacity="0.2"/>
    <SolidColorBrush x:Key="BrushStatusIdle" Color="{DynamicResource ColorStatusIdle}"/>
    <SolidColorBrush x:Key="BrushStatusReady" Color="{DynamicResource ColorStatusReady}"/>
    <SolidColorBrush x:Key="BrushStatusBusy" Color="{DynamicResource ColorStatusBuild}"/>
    <SolidColorBrush x:Key="BrushStatusComplete" Color="{DynamicResource ColorStatusDone}"/>
    <SolidColorBrush x:Key="BrushStatusError" Color="{DynamicResource ColorStatusError}"/>
    <SolidColorBrush x:Key="BrushStatusIdle_Background" Color="{DynamicResource ColorStatusIdle_Background}" Opacity="0.3"/>
    <SolidColorBrush x:Key="BrushStatusReady_Background" Color="{DynamicResource ColorStatusReady_Background}" Opacity="0.3"/>
    <SolidColorBrush x:Key="BrushStatusBusy_Background" Color="{DynamicResource ColorStatusBuild_Background}" Opacity="0.3"/>
    <SolidColorBrush x:Key="BrushStatusComplete_Background" Color="{DynamicResource ColorStatusDone_Background}" Opacity="0.3"/>
    <SolidColorBrush x:Key="BrushStatusError_Background" Color="{DynamicResource ColorStatusError_Background}" Opacity="0.3"/>
    <SolidColorBrush x:Key="BrushStatusIdle_Icon" Color="{DynamicResource ColorStatusIdle_Icon}"/>
    <SolidColorBrush x:Key="BrushStatusReady_Icon" Color="{DynamicResource ColorStatusReady_Icon}"/>
    <SolidColorBrush x:Key="BrushStatusError_Icon" Color="{DynamicResource ColorStatusError_Icon}"/>
    <SolidColorBrush x:Key="BrushPopupBackground" Color="{DynamicResource ColorIdleTextBoxForeground}" Opacity="0.5"/>

    <Color x:Key="ColorWhite">#FFFFFF</Color>
    <Color x:Key="ColorBlack">#2D2D2D</Color>
    <Color x:Key="ColorMainBackground">#323232</Color>
    <Color x:Key="ColorMainThema">#79D4C2</Color>
    <Color x:Key="ColorBorder">#4A4A4A</Color>
    <Color x:Key="ColorSelectedBackground">#96E2D6</Color>
    <Color x:Key="ColorSelectedForeground">#66CAB9</Color>
    <Color x:Key="ColorUnPressedBackground">#2A2A2A</Color>
    <Color x:Key="ColorUnPressedForeground">#2D2D2D</Color>
    <Color x:Key="ColorPressedBackground">#FFFFFF</Color>
    <Color x:Key="ColorIdleBackground">#D7D7D7</Color>
    <Color x:Key="ColorIdleForeground">#FFFFFF</Color>
    <Color x:Key="ColorIdleTextBoxBackground">#2A2A2A</Color>
    <Color x:Key="ColorIdleTextBoxForeground">#909090</Color>
    <Color x:Key="ColorWarning">#F78B02</Color>
    <Color x:Key="ColorError">#F53E2E</Color>
    <Color x:Key="ColorErrorPressed">#D42928</Color>
    
    <Color x:Key="ColorStatusIdle">#66CAB9</Color>
    <Color x:Key="ColorStatusReady">#F78B02</Color>
    <Color x:Key="ColorStatusBuild">#0AB49E</Color>
    <Color x:Key="ColorStatusDone">#41C064</Color>
    <Color x:Key="ColorStatusError">#F53E2E</Color>
    <Color x:Key="ColorStatusIdle_Background">#96E2D6</Color>
    <Color x:Key="ColorStatusReady_Background">#FF940A</Color>
    <Color x:Key="ColorStatusBuild_Background">#12BCA7</Color>
    <Color x:Key="ColorStatusDone_Background">#49C86B</Color>
    <Color x:Key="ColorStatusError_Background">#FD4737</Color>
    <Color x:Key="ColorStatusIdle_Icon">#DBF2EF</Color>
    <Color x:Key="ColorStatusReady_Icon">#FCB74E</Color>
    <Color x:Key="ColorStatusError_Icon">#FFFFA18A</Color>
</ResourceDictionary>