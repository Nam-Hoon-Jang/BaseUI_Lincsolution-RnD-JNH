    <Style x:Key="StEmergencyButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="176"/>
        <Setter Property="Height" Value="88"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
        <Setter Property="FontFamily" Value="{StaticResource font-weight-Meduium}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Grid_Button" 
                          Width="{TemplateBinding Width}" 
                          Height="{TemplateBinding Height}"
                          Background="Transparent">
                        <Border x:Name="Border_Button" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" 
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="Border_ButtonBrush" Color="{DynamicResource ColorBorder}"/>
                            </Border.BorderBrush>
                        </Border>
                        <Grid x:Name="Img_Button" Width="60" Height="60" Background="Transparent"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="15 0 0 0">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="0" CenterX="30" CenterY="30"/>
                            </Grid.RenderTransform>
                            <Image x:Name="Img_Idle" Width="60" Height="60" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Panel.ZIndex="1"
                                   Source="{StaticResource Icon-Emergency-Idle}"/>
                            <Image Width="60" Height="60"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Source="{StaticResource Icon-Emergency-Pressed}"/>

                        </Grid>
                        <ContentPresenter x:Name="Content_Button" Width="90" Height="34" 
                                          Content="{DynamicResource MainSubTitle_EmergencyIdle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 5 0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Img_Button"
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                        From="0"
                                        To="90"
                                        Duration="0:0:0.25"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Content_Button" Property="Content" Value="{DynamicResource MainSubTitle_EmergencyPressed}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="3"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkAtCheckTrue">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames  Storyboard.TargetName="Img_Idle"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame  KeyTime="0:0:0" Value="0"/>
                                            <DiscreteDoubleKeyFrame  KeyTime="0:0:0.5" Value="1"/>
                                            <DiscreteDoubleKeyFrame  KeyTime="0:0:1" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)">
                                            <DiscreteColorKeyFrame KeyTime="0:0:0" Value="{StaticResource ColorErrorPressed}"/>
                                            <DiscreteColorKeyFrame KeyTime="0:0:0.5" Value="{StaticResource ColorError}"/>
                                            <DiscreteColorKeyFrame KeyTime="0:0:1" Value="{StaticResource ColorErrorPressed}"/>
                                        </ColorAnimationUsingKeyFrames>
                                        
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border_ButtonBrush"
                                                                      Storyboard.TargetProperty="Color">
                                            <DiscreteColorKeyFrame KeyTime="0:0:0" Value="{StaticResource ColorErrorPressed}"/>
                                            <DiscreteColorKeyFrame KeyTime="0:0:0.5" Value="{StaticResource ColorError}"/>
                                            <DiscreteColorKeyFrame KeyTime="0:0:1" Value="{StaticResource ColorErrorPressed}"/>
                                        </ColorAnimationUsingKeyFrames>
                                        
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkAtCheckTrue"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Img_Button"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="90"
                                                     To="0"
                                                     Duration="0:0:0.25"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Content_Button" Property="Content" Value="{DynamicResource MainSubTitle_EmergencyIdle}"/>
                            <Setter TargetName="Img_Idle" Property="Opacity" Value="1"/>
                            <Setter TargetName="Border_Button" Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border_Button" Property="BorderBrush" Value="{StaticResource BrushError}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
