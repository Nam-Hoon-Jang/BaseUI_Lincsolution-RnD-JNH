    <!--#region Progress Bar-->
    <Style x:Key="StProgressBarTitle" TargetType="ProgressBar">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Foreground" Value="{StaticResource BrushMainThema}"/>
        <Setter Property="Tag" Value="{StaticResource State.Idle}"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource State.Idle}">
                <Trigger.Setters>
                    <Setter Property="Foreground" Value="{StaticResource BrushMainThema}"/>
                </Trigger.Setters>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Busy}">
                <Trigger.Setters>
                    <Setter Property="Foreground" Value="{DynamicResource BrushStatusReady}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="FadeAtBusy">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.2"
                                             To="1"
                                             Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="FadeAtBusy"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Ready}">
                <Trigger.Setters>
                    <Setter Property="Foreground" Value="{DynamicResource BrushStatusReady}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtReady">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.2"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtReady"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Build}">
                <Setter Property="Foreground" Value="{DynamicResource BrushMainThema}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="FadeAtBuild">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.2"
                                             To="1"
                                             Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="FadeAtBuild"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Pause}">
                <Setter Property="Foreground" Value="{DynamicResource BrushMainThema}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtPause">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.2"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtPause"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Done}">
                <Setter Property="Foreground" Value="{DynamicResource BrushMainThema}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Stop}">
                <Setter Property="Foreground" Value="{DynamicResource BrushError}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtStop">
                        <Storyboard RepeatBehavior="3x">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.2"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtStop"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Warn}">
                <Trigger.Setters>
                    <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtWarning">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.2"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtWarning"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Error}">
                <Trigger.Setters>
                    <Setter Property="Foreground" Value="{DynamicResource BrushError}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtError">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.2"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtError"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->

