    <!--#endregion-->
    <!--#region Border-->
    <Style x:Key="StBorderPopup" TargetType="Border">
        <Setter Property="Tag" Value="{StaticResource Alarm.Info}"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource Alarm.Info}">
                <Setter Property="Background" Value="{DynamicResource BrushStatusIdle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusIdle}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource Alarm.Warn}">
                <Setter Property="Background" Value="{DynamicResource BrushWarning}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource Alarm.Error}">
                <Setter Property="Background" Value="{DynamicResource BrushError}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushError}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->
    <!--#region Image-->
    <Style x:Key="StImgTitle" TargetType="Image">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
    </Style>
    <Style x:Key="StImgPopup" TargetType="Image">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource Alarm.Info}">
                <Setter Property="Source" Value="{StaticResource icon-info}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource Alarm.Warn}">
                <Setter Property="Source" Value="{StaticResource icon-warning}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource Alarm.Error}">
                <Setter Property="Source" Value="{StaticResource icon-error}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->

    <!--#region Label-->
    <Style x:Key="StLabelOverviewStatus" TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Content" Value="Idle"/>
        <Setter Property="FontFamily" Value="{StaticResource font-weight-Regular}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushStatusIdle}"/>
        <Setter Property="Background" Value="{DynamicResource BrushStatusIdle_Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusIdle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Tag" Value="{StaticResource State.Idle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Grid>
                        <Border x:Name="Border_Label" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" 
                                Background="{TemplateBinding Background}" CornerRadius="15"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <TextBlock x:Name="Text_Label" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="10 0 0 0" TextAlignment="Center"/>
                        <Image x:Name="Img_Label" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5 0.5" Margin="8 0 0 0"
                               Source="{StaticResource icon-progressing}">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="RotateIf" Angle="0"/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource State.Idle}">
                            <Setter TargetName="Img_Label" Property="Source" Value="{StaticResource icon-idle}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource BrushStatusIdle}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource DashboardContent_Status_Idle}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource BrushStatusIdle_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource BrushStatusIdle}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource State.Busy}">
                            <Setter TargetName="Img_Label" Property="Source" Value="{StaticResource icon-busy}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource BrushStatusReady}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource DashboardContent_Status_Busy}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource BrushStatusReady_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource BrushStatusReady}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FadeAtBusy">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Border_Label"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.2"
                                                         To="1"
                                                         Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard x:Name="RotateAtBusy">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RotateIf"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FadeAtBusy"/>
                                <StopStoryboard BeginStoryboardName="RotateAtBusy"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource State.Ready}">
                            <Setter TargetName="Img_Label" Property="Source" Value="{StaticResource icon-ready}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource BrushStatusReady}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource DashboardContent_Status_Ready}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource BrushStatusReady_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource BrushStatusReady}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkAtReady">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Border_Label"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.2"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkAtReady"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource State.Build}">
                            <Setter TargetName="Img_Label" Property="Source" Value="{StaticResource icon-progressing}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource BrushStatusBuild}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource DashboardContent_Status_Build}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource BrushStatusBuild_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource BrushStatusBuild}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FadeAtBuild">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Border_Label"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.2"
                                                         To="1"
                                                         Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard x:Name="RotateAtBuild">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RotateIf"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FadeAtBuild"/>
                                <StopStoryboard BeginStoryboardName="RotateAtBuild"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource State.Pause}">
                            <Setter TargetName="Img_Label" Property="Source" Value="{StaticResource icon-progressing}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource BrushStatusBuild}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource DashboardContent_Status_Pause}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource BrushStatusBuild_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource BrushStatusBuild}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkAtPause">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Border_Label"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.2"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkAtPause"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource State.Done}">
                            <Setter TargetName="Img_Label" Property="Source" Value="{StaticResource icon-done}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource BrushStatusDone}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource DashboardContent_Status_Done}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource BrushStatusDone_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource BrushStatusDone}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource State.Stop}">
                            <Setter TargetName="Img_Label" Property="Source" Value="{StaticResource icon-stop}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource BrushStatusError}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource DashboardContent_Status_Stop}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource BrushStatusError_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource BrushStatusError}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkAtStop">
                                    <Storyboard RepeatBehavior="3x">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Border_Label"
                                           Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.2"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkAtStop"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource State.Warn}">
                            <Setter TargetName="Img_Label" Property="Source" Value="{StaticResource icon-warning}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource BrushStatusReady}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource DashboardContent_Status_Warn}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource BrushStatusReady_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource BrushStatusReady}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkAtWarning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Border_Label"
                                           Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.2"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkAtWarning"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource State.Error}">
                            <Setter TargetName="Img_Label" Property="Source" Value="{StaticResource icon-error}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource BrushStatusError}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource DashboardContent_Status_Error}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource BrushStatusError_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource BrushStatusError}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="2"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkAtError">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Border_Label"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0.2"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkAtError"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
