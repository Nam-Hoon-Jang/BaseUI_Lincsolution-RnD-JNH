                            <Setter TargetName="Border_Button" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
