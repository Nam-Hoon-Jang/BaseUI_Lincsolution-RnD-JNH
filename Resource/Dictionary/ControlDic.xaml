                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.5"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
