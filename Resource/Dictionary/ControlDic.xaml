<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:BaseUI">
    
    <local:ScaleToDoubleConverter x:Key="ScaleToDouble"/>
    <local:DateTimeFormatConverter x:Key="DateTimeConverter"/>
    <local:DoubleToStringConverter x:Key="DoubleToString"/>
    <local:DoubleToPercentageStringConverter x:Key="DoubleToPercentageString"/>
    <local:EnumPassThroughConverter x:Key="EnumPassConverter"/>
    <local:ButtonStatusToIsEnabledConverter x:Key="BtnStatusToEnabledConverter"/>
    <local:DoubleToGridLengthConverter x:Key="DoubleToLengthConverter"/>
    <local:ScaleToCornerRadiusConverter x:Key="ScaleToCornerRadiusConverter"/>
    <local:PopupTypeToButtonStateConverter x:Key="PopupTypeToBtnStateConverter"/>
    <local:PopupTypeToAlarmConverter x:Key="PopupTypeToAlarmConverter"/>
    <!--#region Style Tags-->
    <sys:Object x:Key="Mode.Light"/>
    <sys:Object x:Key="Mode.Dark"/>
    
    <sys:Object x:Key="State.Idle"/>
    <sys:Object x:Key="State.Busy"/>
    <sys:Object x:Key="State.Ready"/>
    <sys:Object x:Key="State.Build"/>
    <sys:Object x:Key="State.Pause"/>
    <sys:Object x:Key="State.Done"/>
    <sys:Object x:Key="State.Stop"/>
    <sys:Object x:Key="State.Warn"/>
    <sys:Object x:Key="State.Error"/>
    
    <sys:Object x:Key="State.On"/>
    <sys:Object x:Key="State.Off"/>

    <sys:Object x:Key="Alarm.Info"/>
    <sys:Object x:Key="Alarm.Warn"/>
    <sys:Object x:Key="Alarm.Error"/>

    <sys:Object x:Key="Button.Idle"/>
    <sys:Object x:Key="Button.Info"/>
    <sys:Object x:Key="Button.Warn"/>
    <sys:Object x:Key="Button.Error"/>
    <!--#endregion-->

    <!--#region Grid-->
    <Style x:Key="StGridTitleLogo" TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource BrushMainThema}"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Tag" Value="{StaticResource State.Idle}"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource State.Idle}">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource BrushMainThema}"/>
                </Trigger.Setters>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Busy}">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource BrushStatusReady}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="FadeAtBusy">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.5"
                                             To="1"
                                             Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="FadeAtBusy"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Ready}">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource BrushStatusReady}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtReady">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.5"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtReady"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Build}">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource BrushMainThema}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="FadeAtBuild">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.5"
                                             To="1"
                                             Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="FadeAtBuild"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Pause}">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource BrushMainThema}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtPause">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.5"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtPause"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Done}">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource BrushMainThema}"/>
                </Trigger.Setters>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Stop}">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource BrushStatusError}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtStop">
                        <Storyboard RepeatBehavior="3x">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.5"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtStop"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Warn}">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource BrushWarning}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtWarning">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.5"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtWarning"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Error}">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource BrushError}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtError">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0.5"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtError"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>
