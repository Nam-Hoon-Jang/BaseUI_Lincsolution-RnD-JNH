    <ControlTemplate x:Key="SoftVerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
              Background="Transparent">
            <Border x:Name="Border_ScrollBar" Margin="4,0,4,0"
                    Background="{DynamicResource BrushUnPressedBackground}"
                    CornerRadius="4"/>
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True"
                   Focusable="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Opacity="0"/>
                </Track.DecreaseRepeatButton>

                <Track.Thumb>
                    <Thumb Style="{StaticResource ListViewThumb}"
                           MinHeight="0"
                           Height="50"
                           Width="8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0"/>
                </Track.Thumb>

                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Opacity="0"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border_ScrollBar" Property="Background" Value="{DynamicResource BrushSelectedBackground}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
