                    <Setter Property="Background" Value="{DynamicResource BrushMainThemaLowOpacity}"/>
                </Trigger.Setters>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource State.Stop}">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource BrushErrorLowOpacity}"/>
                </Trigger.Setters>
                <Trigger.EnterActions>
