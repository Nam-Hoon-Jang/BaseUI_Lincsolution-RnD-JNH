                        </EventTrigger>
                        <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="RotateIf"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0"
                                                     To="180"
                                                     Duration="0:0:0.25"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border_Button" Property="BorderBrush" Value="{DynamicResource BrushSelectedForeground}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="3"/>
